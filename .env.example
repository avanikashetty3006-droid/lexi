# Copy to .env (never commit .env). One key is enough to start.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
MODEL_NAME=gemini-3.1-flash-lite

# Optional backup used only after a rate limit (429). Leave empty to disable.
BACKUP_PROVIDER=groq
GROQ_API_KEY=
BACKUP_MODEL=

# Other settings (defaults shown)
THRESHOLD=0.7
N_SAMPLES=5
TEMPERATURE_DETECT=0.0
TEMPERATURE_VOTE=0.8
SEED=42
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
EMBED_MODEL=all-MiniLM-L6-v2
